# ========================================================
# Database Configuration (PostgreSQL Docker)
# ========================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_local_planner
DB_USER=postgres
DB_PASSWORD=postgres

# ========================================================
# Server Configuration (Spring Boot 3)
# ========================================================
SERVER_PORT=8080

# ========================================================
# JWT Security Secrets (Minimum 256-bit secret)
# ========================================================
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_placeholder_value
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# ========================================================
# Cloudinary CDN Configuration
# ========================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
