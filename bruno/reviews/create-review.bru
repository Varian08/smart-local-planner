meta {
  name: Submit Place Review
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/places/{{placeId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "rating": 5,
    "comment": "Wonderful atmosphere and delicious signature coffee!"
  }
}
